# HUB (apps/hub). All optional.
# 0.0.0.0 to let tablets on the club network connect.
HUB_HOST=127.0.0.1
HUB_PORT=4310
# Hall screen dev server (apps/web). Its /api proxy follows HUB_PORT.
WEB_PORT=5173
# Default: apps/hub/data/hub.db
# HUB_DB_PATH=
# Time zone of the demo club created on first start.
HUB_DEMO_TZ=Asia/Almaty
# Built hall screen served by the HUB on /. Default: apps/web/dist (npm run build in the repo root).
# HUB_WEB_DIST=

# ---- HTTPS in the club network (node apps/hub/src/cli.ts ca init prints these) ----
# Server certificate and key (PEM); both empty = plain HTTP on HUB_PORT.
# HUB_TLS_CERT=apps/hub/data/tls/server.crt
# HUB_TLS_KEY=apps/hub/data/tls/server.key
# Root certificate handed out on /ca.crt. Default: ca.crt next to HUB_TLS_CERT.
# HUB_TLS_CA=
# With HTTPS: plain-HTTP port that serves /ca and redirects everything else to HTTPS.
# HUB_HTTP_PORT=
# mDNS name announced in the club network: hub -> hub.local. Empty = off.
# HUB_MDNS_NAME=
# Folder for `ca init`. Default: tls/ next to the database.
# HUB_TLS_DIR=

# ---- Lamps (stage 5) ----
# Relay controller: simulator | esp32-http | modbus-tcp
HUB_LAMP_DRIVER=simulator
# Simulated lamp controller response time, ms.
HUB_SIM_LATENCY_MS=300

# Table channels (billiard_tables.lamp_channel) are addresses:
#   relay-3                     relay 3 on the default board below (demo data uses relay-1…relay-6)
#   esp32:192.168.1.50/3        ESP32 board at that IP, relay 3 (1–8); optional :port
#   modbus:192.168.1.60:502/7   Modbus TCP relay module, relay 7 as printed on the module (1-based)

# esp32-http: board that relay-N channels map onto (host or host:port) and its API_TOKEN, if set.
# HUB_ESP32_HOST=192.168.1.50
# HUB_ESP32_TOKEN=

# modbus-tcp: module that relay-N channels map onto.
# HUB_MODBUS_HOST=192.168.1.60:502
# HUB_MODBUS_UNIT_ID=1
# Relay N is coil N-1 on the wire (1, usual) or coil N (0).
# HUB_MODBUS_COIL_BASE=1
# Read discrete inputs as current sensors (input of relay N = coil address + offset).
# HUB_MODBUS_CURRENT_INPUTS=1
# HUB_MODBUS_CURRENT_INPUT_OFFSET=0

# Poll of relays and current sensors, ms (0 = off); how long "light without a game" /
# "game without light" must last before an alert.
HUB_LAMP_POLL_MS=10000
HUB_LAMP_ALERT_AFTER_MS=60000

# Who may switch manual mode off (X-Actor names, comma-separated) — until PIN login in stage 3.
HUB_MANAGER_ACTORS=Управляющий

# ---- UPS (stage 5) ----
# The UPS the HUB and network gear run on. Empty = no power monitoring.
#   nut://192.168.1.2:3493/ups   Network UPS Tools (upsd), "ups" is the name from ups.conf
#   apcupsd://192.168.1.2:3551   apcupsd NIS (NETSERVER on, NISIP reachable from the HUB)
#   simulator                    in-memory UPS, driven from /api/dev/ups
# HUB_UPS=simulator
# How often the UPS is read, ms; battery charge below this (on battery) raises POWER_CRITICAL.
HUB_UPS_POLL_MS=5000
HUB_UPS_CRITICAL_PERCENT=20

# ---- Cloud (stage 6) ----
# Cloud sync (stage 6). Without CLOUD_URL the HUB runs standalone: the outbox just accumulates.
# CLOUD_URL=http://127.0.0.1:4320
# API key of this HUB, issued by the cloud (see apps/cloud README / demo seed).
# CLOUD_API_KEY=
# Id of this HUB in the cloud; must match the key.
# HUB_ID=
# How often the HUB pushes outbox events and checks settings, ms.
CLOUD_SYNC_INTERVAL_MS=10000

# Cloud server (apps/cloud). All optional.
CLOUD_HOST=127.0.0.1
CLOUD_PORT=4320
# SQLite file (development). Default: apps/cloud/data/cloud.db
# CLOUD_DB_PATH=
# PostgreSQL (production): when set, the cloud uses it instead of SQLite. Not yet verified on a live database.
# CLOUD_DATABASE_URL=postgres://user:pass@host:5432/bills
# Create a demo company, two clubs with HUB keys and an owner login when the database is empty (1/0).
CLOUD_DEMO_SEED=1
# Mark the owner cookie Secure (only behind HTTPS).
# CLOUD_SECURE_COOKIES=1
# Owner cabinet (apps/cloud-web) dev server port.
CLOUD_WEB_PORT=5180
