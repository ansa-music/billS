# Local stand `lead-cloud` (.claude/launch.json): the cloud with its own demo database next to the
# default one, so an old apps/cloud/data/cloud.db from another build does not get in the way.
# No secrets here. Paths are relative to the repository root (the stand starts there).
CLOUD_DB_PATH=apps/cloud/data/lead-cloud.db
CLOUD_DEMO_SEED=1
