# /etc/bills/cloud.env — настройки облака TS на этом мини-ПК («бесплатный режим»).
# Облако — это сервер, куда HUB всех клубов сети присылают события, и кабинет владельца
# (отчёты по клубам в браузере/на телефоне). Здесь оно работает на том же мини-ПК, что и HUB
# главного клуба. Само наличие этого файла означает «облако включено» для скриптов bills.
#
# Файл создаёт `sudo bash install.sh --with-cloud` (если его ещё нет) и больше не трогает.
# Формат: КЛЮЧ=значение, без пробелов вокруг «=», без кавычек.
# После изменения: sudo systemctl restart bills-cloud
# Права: root:bills 640 (пользователь bills только читает).

# ---------- Сеть ----------
# Адрес, на котором слушает облако. 0.0.0.0 — чтобы HUB других клубов достучались до него
# через Tailscale (sudo bills tailscale) и чтобы кабинет открывался из локальной сети.
# 127.0.0.1 — только этот мини-ПК (подходит, если все клубы ходят через Cloudflare Tunnel/Caddy).
# Если включён ufw, install.sh/tailscale.sh открывают порт облака только на интерфейсе tailscale0.
# НЕ пробрасывайте этот порт на роутере: для доступа снаружи есть Tailscale (рекомендуется),
# Cloudflare Tunnel или DuckDNS+Caddy с HTTPS (см. README.md).
CLOUD_HOST=0.0.0.0

# Порт облака и кабинета владельца: http://<адрес мини-ПК>:4320
# HUB других клубов подключаются к http://<адрес Tailscale этого мини-ПК>:4320
CLOUD_PORT=4320

# ---------- Данные ----------
# База облака (SQLite). Папка /var/lib/bills создаётся установщиком.
# Бэкап делает тот же ночной таймер bills-backup (файлы cloud-*.db.gz в папке бэкапов HUB).
CLOUD_DB_PATH=/var/lib/bills/cloud.db

# Демо-данные (тестовая компания, владелец и ключи) при пустой базе. На рабочем мини-ПК — 0:
# компанию и владельца создают командой  sudo bills cloud init --company "…" --email …
CLOUD_DEMO_SEED=0

# ---------- Вход в кабинет ----------
# 1 — cookie входа помечается Secure и браузер отправляет её только по HTTPS.
# Оставьте 0, если кабинет открывают по http:// (Tailscale без --https, локальная сеть) —
# иначе войти не получится. Ставьте 1, только если кабинет открывают ИСКЛЮЧИТЕЛЬНО по https://
# (tailscale.sh --https, Cloudflare Tunnel, duckdns.sh --https).
CLOUD_SECURE_COOKIES=0

# Папка собранного кабинета (npm run build -w @bills/cloud-web). Обычно не нужна:
# по умолчанию облако берёт apps/cloud-web/dist из текущего релиза.
#CLOUD_WEB_DIST=/opt/bills/current/apps/cloud-web/dist
