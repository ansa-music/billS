# billS — ночной бэкап базы HUB. Запускается таймером bills-backup.timer.
# Вручную: systemctl start bills-backup.service  (или: bills backup)

[Unit]
Description=billS: резервная копия базы HUB
Documentation=https://github.com/ansa-music/billS
After=bills-hub.service

[Service]
Type=oneshot
User=bills
Group=bills
WorkingDirectory=/opt/bills/current
EnvironmentFile=/etc/bills/hub.env
ExecStart=/bin/bash /opt/bills/bin/backup.sh
Nice=10
IOSchedulingClass=idle
StateDirectory=bills
ReadWritePaths=/var/lib/bills
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
