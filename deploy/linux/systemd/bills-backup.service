# TS — ночной бэкап базы HUB (и облака, если оно включено на этом мини-ПК:
# есть /etc/bills/cloud.env — тогда backup.sh дополнительно делает cloud-*.db.gz).
# Запускается таймером bills-backup.timer.
# Вручную: systemctl start bills-backup.service  (или: bills backup)

[Unit]
Description=TS: резервная копия базы HUB и облака
Documentation=https://github.com/ansa-music/billS
After=bills-hub.service bills-cloud.service

[Service]
Type=oneshot
User=bills
Group=bills
WorkingDirectory=/opt/bills/current
EnvironmentFile=/etc/bills/hub.env
ExecStart=/bin/bash /opt/bills/bin/backup.sh
Nice=10
IOSchedulingClass=idle
StateDirectory=bills
ReadWritePaths=/var/lib/bills
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
