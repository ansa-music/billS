# /etc/bills/hub.env — настройки billS HUB на этом сервере.
# Формат: КЛЮЧ=значение, без пробелов вокруг «=», без кавычек.
# После изменения: sudo systemctl restart bills-hub

# ---------- HUB ----------
# Адрес, на котором слушает HUB. 0.0.0.0 — чтобы планшеты в локальной сети подключались.
# ВАЖНО: HUB не должен быть доступен из интернета — только из LAN клуба.
HUB_HOST=0.0.0.0

# Порт HUB. Планшеты открывают http://<ip-сервера>:<порт>
HUB_PORT=4310

# Путь к базе данных SQLite. Папка /var/lib/bills создаётся установщиком.
HUB_DB_PATH=/var/lib/bills/hub.db

# Часовой пояс клуба (для демо-данных при первом запуске и отчётов).
HUB_DEMO_TZ=Asia/Almaty

# Имитация задержки контроллера ламп, мс (нужна только без реального контроллера).
HUB_SIM_LATENCY_MS=300

# Файл-маркер последнего бэкапа (его читает /api/health и /metrics).
# По умолчанию — рядом с базой: /var/lib/bills/last-backup.json
#HUB_BACKUP_MARKER=/var/lib/bills/last-backup.json

# Переопределение git sha для /api/health (обычно не нужно — берётся из релиза).
#HUB_GIT_SHA=

# ---------- Бэкапы (backup.sh, таймер bills-backup.timer, 03:30 ежедневно) ----------
# Куда складывать копии базы (hub-ГГГГ-ММ-ДД_ЧЧ-мм-сс.db.gz).
BACKUP_DIR=/var/lib/bills/backups

# Сколько дней хранить копии (старше — удаляются; и локально, и в rclone, и на втором диске).
BACKUP_KEEP_DAYS=30

# Необязательно: удалённое хранилище rclone, например gdrive:bills-backups/club-1
# Настройка: sudo apt install rclone && sudo -u bills -H rclone config
# Пусто — выгрузка в облако отключена.
BACKUP_RCLONE_REMOTE=

# Необязательно: папка на втором диске или USB-флешке для дополнительной копии,
# например /mnt/usb/bills-backups. Копируется только если диск примонтирован.
# Пусто — отключено.
BACKUP_SECOND_DIR=
