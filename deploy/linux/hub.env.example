# /etc/bills/hub.env — настройки TS HUB на этом сервере.
# Формат: КЛЮЧ=значение, без пробелов вокруг «=», без кавычек.
# После изменения: sudo systemctl restart bills-hub

# ---------- HUB ----------
# Адрес, на котором слушает HUB. 0.0.0.0 — чтобы планшеты в локальной сети подключались.
# ВАЖНО: HUB не должен быть доступен из интернета — только из LAN клуба.
HUB_HOST=0.0.0.0

# Порт HUB. Планшеты открывают http://<ip-сервера>:<порт>
HUB_PORT=4310

# ---------- HTTPS в сети клуба (bills ca init заполняет сам) ----------
# Сертификат HUB, его ключ и корневой сертификат клуба (раздаётся планшетам на /ca).
# Пусто — HUB работает по обычному HTTP на HUB_PORT.
#HUB_TLS_CERT=/var/lib/bills/tls/server.crt
#HUB_TLS_KEY=/var/lib/bills/tls/server.key
#HUB_TLS_CA=/var/lib/bills/tls/ca.crt
# Порт обычного HTTP при включённом HTTPS: отдаёт сертификат (/ca) и переводит всё остальное на https.
#HUB_HTTP_PORT=80
# Имя в сети клуба: hub → https://hub.local (HUB объявляет его сам, mDNS). Пусто — не объявлять.
#HUB_MDNS_NAME=hub

# Путь к базе данных SQLite. Папка /var/lib/bills создаётся установщиком.
HUB_DB_PATH=/var/lib/bills/hub.db

# Часовой пояс клуба (для демо-данных при первом запуске и отчётов).
HUB_DEMO_TZ=Asia/Almaty

# Имитация задержки контроллера ламп, мс (нужна только без реального контроллера).
HUB_SIM_LATENCY_MS=300

# Файл-маркер последнего бэкапа (его читает /api/health и /metrics).
# По умолчанию — рядом с базой: /var/lib/bills/last-backup.json
#HUB_BACKUP_MARKER=/var/lib/bills/last-backup.json

# Переопределение git sha для /api/health (обычно не нужно — берётся из релиза).
#HUB_GIT_SHA=

# ---------- Бэкапы (backup.sh, таймер bills-backup.timer, 03:30 ежедневно) ----------
# Куда складывать копии базы (hub-ГГГГ-ММ-ДД_ЧЧ-мм-сс.db.gz).
BACKUP_DIR=/var/lib/bills/backups

# Сколько дней хранить копии (старше — удаляются; и локально, и в rclone, и на втором диске).
BACKUP_KEEP_DAYS=30

# Необязательно: удалённое хранилище rclone, например gdrive:bills-backups/club-1
# Настройка: sudo apt install rclone && sudo -u bills -H rclone config
# Пусто — выгрузка в облако отключена.
BACKUP_RCLONE_REMOTE=

# Необязательно: папка на втором диске или USB-флешке для дополнительной копии,
# например /mnt/usb/bills-backups. Копируется только если диск примонтирован.
# Пусто — отключено.
BACKUP_SECOND_DIR=

# ---------- Облако TS (кабинет владельца) ----------
# Куда HUB отправляет события клуба. Пусто/закомментировано — HUB работает без облака.
# Проще всего — мастер настройки: пока HUB не подключён, он открыт из сети клуба по адресу
# http://<ip-сервера>:4310/setup (или http://hub.local:4310/setup). Туда вставляют код подключения
# из кабинета (или QR) и выбирают контроллер ламп; мастер проверяет ключ, сохраняет всё в
# /var/lib/bills/setup.json (рядом с базой, права 0600) и перезапускает HUB, после чего закрывается.
# Значения из этого файла дополняют hub.env: облако берётся из setup.json, если здесь не заданы
# HUB_ID и CLOUD_API_KEY; контроллер ламп — если здесь не задан HUB_LAMP_DRIVER.
# Если строки ниже заполнены, мастер закрыт. Запустить мастер заново: удалить setup.json и перезапустить HUB.
# CLOUD_URL без HUB_ID и ключа не подключает HUB, а только подсказывает мастеру адрес облака
# (публичное облако: https://<ID>.supabase.co/functions/v1).
# Другое место файла мастера:
#HUB_SETUP_FILE=/var/lib/bills/setup.json
# Клуб работает без облака намеренно — закрыть мастер, чтобы его не открыл никто из сети клуба:
#HUB_SETUP=off
# Или эти три строки записывают команды:
#   на главном мини-ПК (облако здесь же): sudo bills cloud add-club --name "Клуб" --connect
#   в другом клубе сети:                  sudo bills connect-cloud --url http://<адрес-облака>:4320 --hub-id <HUB_ID> --key <CLOUD_API_KEY>
#CLOUD_URL=http://127.0.0.1:4320
#HUB_ID=
#CLOUD_API_KEY=
