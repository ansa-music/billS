# Cloudflare Pages: HTTP headers of the published site (GitHub Pages and the HUB ignore this file).
# The PWA must notice a new build: the page, the service worker and the manifest are always
# revalidated; hashed files under /assets/ never change and are cached for a year.
# Rules add up, so Cache-Control is set by exactly one rule per path.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
/registerSW.js
  Cache-Control: no-cache
/workbox-*
  Cache-Control: no-cache
/push-sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=86400
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
